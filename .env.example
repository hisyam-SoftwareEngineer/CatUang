# .env.example — Template env vars. Copy to .env and fill in real values.
# DO NOT commit .env to git.

# PostgreSQL connection string from Supabase (use pooler URL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true&connection_limit=1"

# Redis connection string from Upstash (MUST use rediss:// with double-s for TLS)
REDIS_URL="rediss://user:password@host:6379"

# JWT secrets — generate with: openssl rand -base64 32
JWT_ACCESS_SECRET="your-jwt-access-secret-minimum-32-characters-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-minimum-32-characters-different"

# CSRF protection secret
CSRF_SECRET="your-csrf-secret-minimum-32-characters-here"

# Application environment
NODE_ENV="development"

# Server port
PORT="3000"

# Frontend origin allowed by CORS (no trailing slash)
ALLOWED_ORIGIN="http://localhost:3001"

# ─── Cloudinary (optional — untuk upload gambar struk/invoice) ───────────────
# Daftar gratis di https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Mindee OCR (optional — primary OCR provider) ────────────────────────────
# Daftar gratis di https://mindee.com (500 pages/bulan free)
MINDEE_API_KEY="your-mindee-api-key"

# ─── Azure Computer Vision (optional — fallback OCR provider) ────────────────
# Buat resource di https://portal.azure.com → Computer Vision
AZURE_VISION_ENDPOINT="https://your-resource.cognitiveservices.azure.com/"
AZURE_VISION_KEY="your-azure-vision-key"

# ─── Google Gemini (optional — AI-powered OCR provider) ──────────────────────
# Dapatkan API key di https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ─── Google Cloud Vision (optional — OCR provider) ───────────────────────────
# Pilihan 1: API key (lebih mudah, daftar di https://console.cloud.google.com)
GOOGLE_CLOUD_VISION_API_KEY="your-google-cloud-vision-api-key"
# Pilihan 2: Service Account credentials file path (alternatif API key)
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ─── Tesseract (optional — local OCR provider, tanpa API) ────────────────────
# Default: ind+eng (Bahasa Indonesia + English). Format: kode-lang+kode-lang
TESSERACT_LANG="ind+eng"

# ─── WhatsApp Business API (Meta) ─────────────────────────────────────────
# Daftar di https://developers.facebook.com → My Apps → WhatsApp → Setup
# VERIFY_TOKEN: bebas diisi string apapun — harus sama dengan yang diset di Meta Dashboard
WA_VERIFY_TOKEN="your-custom-verify-token"
# ACCESS_TOKEN: Bearer token dari Meta Graph API (permanent / system user token)
WA_ACCESS_TOKEN="your-meta-graph-api-access-token"
# PHONE_NUMBER_ID: ID nomor WA Bisnis (bukan nomor teleponnya, tapi ID dari Meta Dashboard)
WA_PHONE_NUMBER_ID="your-wa-phone-number-id"

