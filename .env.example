# .env.example — Template env vars. Copy to .env and fill in real values.
# DO NOT commit .env to git.

# PostgreSQL connection string from Supabase (use pooler URL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true&connection_limit=1"

# Redis connection string from Upstash (MUST use rediss:// with double-s for TLS)
REDIS_URL="rediss://user:password@host:6379"

# JWT secrets — generate with: openssl rand -base64 32
JWT_ACCESS_SECRET="your-jwt-access-secret-minimum-32-characters-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-minimum-32-characters-different"

# CSRF protection secret
CSRF_SECRET="your-csrf-secret-minimum-32-characters-here"

# Application environment
NODE_ENV="development"

# Server port
PORT="3000"

# Frontend origin allowed by CORS (no trailing slash)
ALLOWED_ORIGIN="http://localhost:3001"

# ─── Cloudinary (optional — untuk upload gambar struk/invoice) ───────────────
# Daftar gratis di https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Mindee OCR (optional — primary OCR provider) ────────────────────────────
# Daftar gratis di https://mindee.com (500 pages/bulan free)
MINDEE_API_KEY="your-mindee-api-key"

# ─── Azure Computer Vision (optional — fallback OCR provider) ────────────────
# Buat resource di https://portal.azure.com → Computer Vision
AZURE_VISION_ENDPOINT="https://your-resource.cognitiveservices.azure.com/"
AZURE_VISION_KEY="your-azure-vision-key"
